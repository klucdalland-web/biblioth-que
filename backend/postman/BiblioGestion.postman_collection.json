            "url": "{{baseUrl}}/auteurs/{{id_auteur}}"
          }
        },
        {
          "name": "Create Auteur",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
