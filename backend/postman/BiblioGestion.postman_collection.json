            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nom\": \"Marie Curie\",\n  \"contact\": \"marie.curie@email.com\"\n}"
            },
            "url": "{{baseUrl}}/adherents"
          }
        },
        {
          "name": "Update Adherent",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
