                  "if (data && data.id_auteur) {",
                  "  pm.collectionVariables.set('id_auteur', String(data.id_auteur));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-device-key", "value": "{{deviceKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nom\": \"Victor Hugo\",\n  \"nationalite\": \"Française\"\n}"
            },
            "url": "{{baseUrl}}/auteurs"
          }
        },
        {
          "name": "Update Auteur",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-device-key", "value": "{{deviceKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nom\": \"Victor Hugo\",\n  \"nationalite\": \"France\"\n}"
            },
            "url": "{{baseUrl}}/auteurs/{{id_auteur}}"
          }
        },
        {
          "name": "Delete Auteur",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "x-device-key", "value": "{{deviceKey}}" }
            ],
            "url": "{{baseUrl}}/auteurs/{{id_auteur}}"
          }
        }
      ]
    },
    {
      "name": "Livres",
      "item": [
        {
          "name": "List Livres",
          "request": {
            "method": "GET",
            "header": [
              { "key": "x-device-key", "value": "{{deviceKey}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/livres?page=1&limit=10&search=",
              "host": ["{{baseUrl}}"],
              "path": ["livres"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "search", "value": "", "description": "Optionnel" }
              ]
            },
            "description": "Liste paginée. Query optionnelle : `search`, `statut`, `id_auteur`."
          }
        },
        {
          "name": "Get Livre",
          "request": {
            "method": "GET",
            "header": [
              { "key": "x-device-key", "value": "{{deviceKey}}" }
            ],
            "url": "{{baseUrl}}/livres/{{id_livre}}"
          }
        },
        {
          "name": "Create Livre",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "const data = json && json.data ? json.data : json;",
                  "if (data && data.id_livre) {",
                  "  pm.collectionVariables.set('id_livre', String(data.id_livre));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-device-key", "value": "{{deviceKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titre\": \"Les Misérables\",\n  \"id_auteur\": {{id_auteur}},\n  \"annee_publication\": 1862,\n  \"statut\": \"disponible\"\n}"
            },
            "url": "{{baseUrl}}/livres",
            "description": "`statut` optionnel : `disponible` | `emprunte`"
          }
        },
        {
          "name": "Update Livre",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-device-key", "value": "{{deviceKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titre\": \"Les Misérables\",\n  \"id_auteur\": {{id_auteur}},\n  \"annee_publication\": 1862,\n  \"statut\": \"disponible\"\n}"
            },
            "url": "{{baseUrl}}/livres/{{id_livre}}"
          }
        },
        {
          "name": "Delete Livre",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "x-device-key", "value": "{{deviceKey}}" }
            ],
            "url": "{{baseUrl}}/livres/{{id_livre}}"
          }
        }
      ]
    },
    {
      "name": "Adherents",
      "item": [
        {
          "name": "List Adherents",
          "request": {
            "method": "GET",
            "header": [
              { "key": "x-device-key", "value": "{{deviceKey}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/adherents?search=",
              "host": ["{{baseUrl}}"],
              "path": ["adherents"],
              "query": [
                { "key": "search", "value": "", "description": "Optionnel" }
              ]
            }
          }
        },
        {
