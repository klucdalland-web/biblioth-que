PORT=3000
NODE_ENV=development

# --- PostgreSQL / Supabase ---
# IMPORTANT : n'utilise PAS l'URI "Direct" (db.xxx.supabase.co) depuis un Mac
# sans IPv6 — tu auras ENOTFOUND. Utilise le POOLER (Session mode) :
#
# Dashboard → Connect → Connection string → Method: Session pooler
# Format typique :
#   postgresql://postgres.PROJECT_REF:MOT_DE_PASSE@aws-0-REGION.pooler.supabase.com:5432/postgres
#
# Mot de passe = Database password (Settings → Database), PAS la clé API.
DATABASE_URL=postgresql://postgres.wfxcskbkntlrlybxczvz:YOUR_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Optionnel (auth reste JWT custom dans ce projet)
SUPABASE_URL=https://wfxcskbkntlrlybxczvz.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=https://wfxcskbkntlrlybxczvz.supabase.co/auth/v1/.well-known/jwks.json

DEVICE_KEY=ma_cle_device_secrete

JWT_SECRET=une_longue_chaine_aleatoire_a_generer
JWT_EXPIRES_IN=15m
REFRESH_EXPIRES_DAYS=7
