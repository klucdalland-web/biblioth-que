            "body": {
              "mode": "raw",
              "raw": "{\n  \"id_adherent\": {{id_adherent}},\n  \"id_livre\": {{id_livre}},\n  \"date_retour_prevue\": \"2026-10-02\"\n}"
            },
            "url": "{{baseUrl}}/emprunts",
            "description": "`date_emprunt` optionnelle. Le livre doit être `disponible`."
          }
        },
        {
          "name": "Retour Emprunt",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-device-key", "value": "{{deviceKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": "{{baseUrl}}/emprunts/{{id_emprunt}}/retour",
            "description": "Marquer le livre comme retourné. Body vide ou `{ \"date_retour_reelle\": \"2026-09-18\" }`."
          }
        }
      ]
    },
    {
      "name": "Users (Admin)",
      "description": "Réservé aux utilisateurs avec `role = admin`.",
